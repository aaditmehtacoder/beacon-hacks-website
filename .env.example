# Where the updates list is stored. Add "Upstash Redis" from the
# Vercel Marketplace and these are set for you. Locally, .data/entries.json is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: every signup is also POSTed here as JSON (Formspree, a Worker, a sheet proxy).
NOTIFY_WEBHOOK_URL=

# The organizers' page at /admin (signed waivers and check-in). One shared
# password; in development it defaults to "cwb".
ADMIN_PASSWORD=

# Each signed waiver is emailed to the team inbox. A Gmail app password for
# the team account (myaccount.google.com/apppasswords, needs 2-Step
# Verification). Without these, waivers are saved but not emailed.
GMAIL_USER=team.beaconhacks@gmail.com
GMAIL_APP_PASSWORD=
# Optional: where the copies go, if not GMAIL_USER.
WAIVER_NOTIFY_TO=
