# Admin dashboard at /admin. Required in production; "cwb" is the default in development only.
ADMIN_PASSWORD=

# Where applications and the notify list are stored. Add "Upstash Redis" from the
# Vercel Marketplace and these are set for you. Locally, .data/entries.json is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: every signup is also POSTed here as JSON (Formspree, a Worker, a sheet proxy).
NOTIFY_WEBHOOK_URL=

# Outreach dashboard at /outreachdashboard (same password as /admin).
# Read-only Gmail for the team mailbox: a Google Cloud OAuth client with the
# gmail.readonly scope. Run `node scripts/gmail-auth.mjs` once to turn it into
# a refresh token; the script stores GOOGLE_REFRESH_TOKEN here.
OUTREACH_MAILBOX=team.beaconhacks@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GOOGLE_REFRESH_TOKEN=
# Which threads count as outreach. Threads the mailbox did not start are dropped anyway.
OUTREACH_QUERY=in:sent

# Optional: summarises the threads a person answered and decides whether the
# door is open or closed. Without it those threads are listed but not summarised.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vercel signs the daily cron call to /api/outreach/sync with this.
CRON_SECRET=
